# Set these only after creating a Supabase project. Never expose a secret key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Auth administration for creating internal users. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only database connection used by Drizzle migrations and trusted jobs.
# Keep this out of client bundles and never commit real credentials.
DATABASE_URL=

# KrediMax Automated Backups & Disaster Recovery (AES-256-GCM)
# 64 hex characters (32 bytes) secret key used to encrypt backups before Google Drive upload.
# KEEP OUTSIDE GOOGLE DRIVE. Never expose to client bundles or browser.
KREDIMAX_BACKUP_KEY=

# Optional webhook/cron secret to trigger automated backups via /api/backups/trigger
KREDIMAX_BACKUP_CRON_SECRET=

# Google Drive Integration (Service Account recommended for unattended backups)
# Option A: Service Account (create at Google Cloud Console and share 'KrediMax' folder with this email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or single-line JSON string:
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: OAuth 2.0 (if using user credentials instead of service account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: ID of existing root folder in Google Drive (if omitted, creates 'KrediMax/Backups')
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# Adjuntos de solicitudes en una carpeta privada de Mi unidad.
# scripts/configure-application-drive.mjs genera estos valores en .env.local.
GOOGLE_DRIVE_APPLICATION_CLIENT_ID=
GOOGLE_DRIVE_APPLICATION_CLIENT_SECRET=
GOOGLE_DRIVE_APPLICATION_REFRESH_TOKEN=
GOOGLE_DRIVE_APPLICATION_FOLDER_ID=
GOOGLE_DRIVE_APPLICATION_TENANT_ID=
