# Set these only after creating a Supabase project. Never expose a secret key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Auth administration for creating internal users. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only database connection used by Drizzle migrations and trusted jobs.
# Keep this out of client bundles and never commit real credentials.
DATABASE_URL=

# Adjuntos de solicitudes en una carpeta privada de Mi unidad.
# scripts/configure-application-drive.mjs genera estos valores en .env.local.
GOOGLE_DRIVE_APPLICATION_CLIENT_ID=
GOOGLE_DRIVE_APPLICATION_CLIENT_SECRET=
GOOGLE_DRIVE_APPLICATION_REFRESH_TOKEN=
GOOGLE_DRIVE_APPLICATION_FOLDER_ID=
GOOGLE_DRIVE_APPLICATION_TENANT_ID=
