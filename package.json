{
  "name": "kredimax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:code": "npm run test && npm run lint && npm run typecheck && npm run build && node scripts/assert-next-proxy-manifest.mjs",
    "db:generate": "drizzle-kit generate",
    "demo:local": "node scripts/seed-demo-local.mjs",
    "demo:verify": "node scripts/seed-demo-local.mjs verify",
    "demo:sellers": "node scripts/seed-demo-sellers.mjs",
    "db:test:cash": "node scripts/test-cash-closings.mjs",
    "db:test:applications": "node scripts/test-application-creator-scope.mjs",
    "db:migrate": "node scripts/run-local-migrations.mjs",
    "db:preflight:local": "node scripts/check-local-data-compatibility.mjs",
    "db:backup:local": "node scripts/local-db-backup.mjs backup",
    "db:restore:local": "node scripts/local-db-backup.mjs restore",
    "db:drop-restore:local": "node scripts/local-db-backup.mjs drop-restore",
    "db:test:backup:local": "node scripts/test-local-db-backup.mjs",
    "db:test:local": "node scripts/run-local-financial-test.mjs",
    "db:test:recovery": "node scripts/test-recovery-installments.mjs",
    "db:test:customers": "node scripts/test-customer-collections.mjs",
    "db:test:portfolios": "node scripts/test-customer-portfolios.mjs",
    "db:test:vouchers": "node scripts/test-receipt-directory.mjs",
    "verify:local": "npm run db:preflight:local && npm run verify:code && npm run db:migrate && npm run db:preflight:local && npm run db:test:local && npm run db:test:backup:local",
    "db:test:evidence": "node scripts/test-payment-evidence.mjs",
    "db:test:concurrency": "node scripts/run-local-financial-test.mjs --concurrency-only"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
